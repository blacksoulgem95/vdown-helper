{
  "name": "vdown-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Detect. Decode. Download. Video detection and download assistant for Chrome.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "desktop:ui": "node scripts/build-desktop-ui.mjs",
    "core": "node scripts/build-core.mjs",
    "pretypecheck": "node scripts/build-core.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/build-core.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run.mjs",
    "test:desktop": "node e2e/desktop.mjs",
    "test:link": "node e2e/link.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "serve:fixtures": "node e2e/serve.mjs",
    "package": "node scripts/build.mjs && node scripts/check-dist.mjs && node scripts/package.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "site:build": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "fflate": "^0.8.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dashjs": "^5.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "hls.js": "^1.7.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
